# Environment Variables Example
# Copy this file to .env and fill in actual values

# Database
DATABASE_URL=postgresql://techorbit:techorbit_dev@localhost:5432/techorbit

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT (generate with: openssl genrsa -out private.pem 2048)
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# SMTP (Mailpit for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@techorbit.local

# Services (ports)
PORT_API_GATEWAY=3001
PORT_IDENTITY=3002
PORT_PROFILE=3003
PORT_REQUIREMENT=3004
PORT_MATCHING=3005
PORT_INTERVIEW=3006
PORT_PLACEMENT=3007
PORT_PAYMENTS=3008
PORT_MESSAGING=3009
PORT_NOTIFICATION=3010
PORT_RATING=3011
PORT_AUDIT=3012
PORT_REPORTING=3013
PORT_ONBOARDING=3014

# Logging
LOG_LEVEL=info

# Node Environment
NODE_ENV=development