# Environment Variables Example
# Copy this file to .env and fill in actual values

# Database
DATABASE_URL=postgresql://techorbit:techorbit_dev@localhost:5432/techorbit

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT — RS256 (generate with: ./scripts/generate-jwt-keys.sh)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Field-level encryption key (for 2FA secrets, SSN, etc.)
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEK_V1=

# Session cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_IDENTITY_URL=http://localhost:3002

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/auth/oauth/google/callback

# OAuth — LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3002/api/v1/auth/oauth/linkedin/callback

# SMTP (Mailpit for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@techorbit.dev

# 2FA — SMS (Twilio sandbox; leave blank to use mock adapter locally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Services (ports)
PORT_API_GATEWAY=3001
PORT_IDENTITY=3002
PORT_PROFILE=3003
PORT_REQUIREMENT=3004
PORT_MATCHING=3005
PORT_INTERVIEW=3006
PORT_PLACEMENT=3007
PORT_PAYMENTS=3008
PORT_MESSAGING=3009
PORT_NOTIFICATION=3010
PORT_RATING=3011
PORT_AUDIT=3012
PORT_REPORTING=3013
PORT_ONBOARDING=3014

# Logging
LOG_LEVEL=info

# Node Environment
NODE_ENV=development
