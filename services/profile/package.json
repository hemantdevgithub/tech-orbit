{
  "name": "@techorbit/profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --build",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:migrate:prod": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.14.0",
    "@techorbit/auth-middleware": "workspace:*",
    "@techorbit/db-client": "workspace:*",
    "@techorbit/errors": "workspace:*",
    "@techorbit/event-bus": "workspace:*",
    "@techorbit/logger": "workspace:*",
    "@techorbit/types": "workspace:*",
    "fastify": "^4.26.2",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prisma/client": "^5.14.0",
    "@techorbit/config-tsconfig": "workspace:*",
    "@techorbit/config-vitest": "workspace:*",
    "@testcontainers/postgresql": "^10.10.0",
    "@types/node": "^25.6.0",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.14.0",
    "testcontainers": "^10.10.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.0",
    "jose": "^5.2.4",
    "vitest": "^1.6.1"
  }
}
