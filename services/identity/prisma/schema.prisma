// Techorbit Identity Service — Prisma Schema
// Schema name: identity (connects to identity_* tables)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserRoleStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum UserRoleType {
  CUSTOMER
  CANDIDATE
  CRM
  SRM
  MSME
  INTERVIEWER
  ADMIN
}

enum TwoFAKind {
  TOTP
  SMS
}

enum OutgoingEventStatus {
  PENDING
  SENT
  FAILED
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(uuid())
  email         String      @unique @map("email")
  passwordHash  String?     @map("password_hash")
  firstName     String      @map("first_name")
  lastName      String      @map("last_name")
  status        UserStatus @default(PENDING) @map("status")
  emailVerified Boolean     @default(false) @map("email_verified")
  has2FA        Boolean     @default(false) @map("has_2fa")

  // OAuth fields (nullable — email-pw users won't have these)
  googleSub    String?  @unique @map("google_sub")
  linkedinSub  String?  @unique @map("linkedin_sub")
  oauthProfile String?  @map("oauth_profile") // JSON snapshot of OAuth user profile

  // 2FA fields (field-level encrypted via application-level encryption)
  twoFASecretEncrypted Json? @map("two_fa_secret_encrypted")
  twoFABackupHash String?    @map("two_fa_backup_hash") // comma-separated SHA-256 hashes

  // Verification (for future email verification flow)
  emailVerifyToken     String?   @map("email_verify_token")
  emailVerifyTokenExp  DateTime? @map("email_verify_token_exp")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  roles          UserRole[]
  sessions       Session[]
  twoFAChallenges TwoFAChallenge[]
  passwordResets PasswordResetRequest[]

  @@index([email])
  @@index([googleSub])
  @@index([linkedinSub])
  @@map("identity_user")
}

// ─── UserRole ─────────────────────────────────────────────────────────────────

model UserRole {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  roleType       UserRoleType  @map("role_type")
  status         UserRoleStatus @default(PENDING_VERIFICATION) @map("status")

  // Role-specific verification data (JSON — KYC result, LinkedIn data, etc.)
  verificationData Json?   @map("verification_data")

  // Staff verification fields (for CRM/SRM/INTERVIEWER)
  verifiedBy  String?   @map("verified_by")
  verifiedAt  DateTime? @map("verified_at")
  rejectNotes String?   @map("reject_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleType])
  @@index([userId])
  @@map("identity_user_role")
}

// ─── Session ─────────────────────────────────────────────────────────────────

model Session {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  refreshTokenHash   String    @unique @map("refresh_token_hash") // SHA-256 hash of opaque token
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  expiresAt          DateTime  @map("expires_at")
  lastActiveAt       DateTime @default(now()) @map("last_active_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  revokedAt          DateTime? @map("revoked_at")
  revokedReason      String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("identity_session")
}

// ─── TwoFAChallenge ──────────────────────────────────────────────────────────

model TwoFAChallenge {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  code      String    @map("code")        // SHA-256 hash of the 6-digit code
  kind      TwoFAKind @default(TOTP) @map("kind")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("identity_two_fa_challenge")
}

// ─── PasswordResetRequest ─────────────────────────────────────────────────────

model PasswordResetRequest {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // SHA-256 hash of reset token
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("identity_password_reset_request")
}

// ─── OutgoingEvent (Transactional Outbox) ─────────────────────────────────────
// Written in the same transaction as the state change; published by a background worker.
// See: https://docs.microsoft.com/en-us/previous-versions/msp-np/dn589795(v=pandp.10)

model OutgoingEvent {
  id            String            @id @default(uuid())
  type          String            @map("type")           // e.g. "user.registered.v1"
  payload       Json              @map("payload")         // JSON-serialized event envelope
  correlationId String?           @map("correlation_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  publishedAt   DateTime?         @map("published_at")
  status        OutgoingEventStatus @default(PENDING) @map("status")
  retryCount    Int               @default(0) @map("retry_count")
  lastError     String?           @map("last_error")

  @@index([status, createdAt])
  @@map("identity_outgoing_event")
}
