{
  "name": "techorbit",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:seed": "./scripts/seed.sh",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@techorbit/config-eslint": "workspace:*",
    "@techorbit/config-prettier": "workspace:*",
    "@techorbit/config-tsconfig": "workspace:*",
    "@techorbit/config-vitest": "workspace:*",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}