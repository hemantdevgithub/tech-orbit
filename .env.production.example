# Copy to .env.production and fill in every CHANGE_ME before running
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=techorbit
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=techorbit
DATABASE_URL=postgresql://techorbit:CHANGE_ME_STRONG_PASSWORD@postgres:5432/techorbit

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=techorbit
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_URL=amqp://techorbit:CHANGE_ME_STRONG_PASSWORD@rabbitmq:5672

# ─── JWT keys (RS256) ────────────────────────────────────────────────────────
# Generate with:  ./scripts/generate-jwt-keys.sh
# Multi-line PEMs must be on one line with \n escapes (each service normalizes
# them at boot).
JWT_PRIVATE_KEY="CHANGE_ME_PEM_PKCS8_PRIVATE_KEY"
JWT_PUBLIC_KEY="CHANGE_ME_PEM_SPKI_PUBLIC_KEY"

# ─── Field-level encryption (2FA secrets, PII) ───────────────────────────────
# 32-byte base64: openssl rand -base64 32
FIELD_ENCRYPTION_KEK_V1=CHANGE_ME_BASE64_32BYTES

# ─── CORS / origins ──────────────────────────────────────────────────────────
# Your real domain(s), comma-separated. Must match the scheme the browser uses.
ALLOWED_ORIGINS=https://techorbit.example.com

# ─── Email + SMS (leave blank to use mocks) ──────────────────────────────────
EMAIL_FROM=no-reply@techorbit.example.com
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Public service URLs (seen by the browser) ───────────────────────────────
# All routed through nginx at /api, but the Next app currently calls each
# service directly. Behind the reverse proxy these become:
#   https://techorbit.example.com/api/identity  → identity-svc
#   https://techorbit.example.com/api/profile   → profile-svc
#   ...
# For v1, point each at https://<your-domain>/api/<service-name>.
NEXT_PUBLIC_IDENTITY_URL=https://techorbit.example.com/api/identity
NEXT_PUBLIC_PROFILE_URL=https://techorbit.example.com/api/profile
NEXT_PUBLIC_FILE_URL=https://techorbit.example.com/api/file
NEXT_PUBLIC_REQUIREMENT_URL=https://techorbit.example.com/api/requirement
NEXT_PUBLIC_MATCHING_URL=https://techorbit.example.com/api/matching
NEXT_PUBLIC_INTERVIEW_URL=https://techorbit.example.com/api/interview
NEXT_PUBLIC_PLACEMENT_URL=https://techorbit.example.com/api/placement
NEXT_PUBLIC_PAYMENTS_URL=https://techorbit.example.com/api/payments
NEXT_PUBLIC_MESSAGING_URL=https://techorbit.example.com/api/messaging
NEXT_PUBLIC_NOTIFICATION_URL=https://techorbit.example.com/api/notification
NEXT_PUBLIC_RATING_URL=https://techorbit.example.com/api/rating
NEXT_PUBLIC_ADMIN_URL=https://techorbit.example.com/api/admin
